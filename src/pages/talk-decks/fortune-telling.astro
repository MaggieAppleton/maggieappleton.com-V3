---
import type { ImageMetadata } from 'astro';
import EditorHmrGuard from '../../editor/rendering/EditorHmrGuard.astro';
import markup from '../../components/unique/fortune-telling/slides.html?raw';

// Resolve the deck's embedded images through Astro, just like the mobile slides.
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/images/posts/fortune-telling/media/*', { eager: true },
);
let slides = markup;
for (const [filename, image] of Object.entries(images)) {
  const name = filename.slice(filename.lastIndexOf('/') + 1);
  slides = slides.replaceAll('./media/' + encodeURIComponent(name), image.default.src);
}
---
<!doctype html>
<html lang="en-GB">
  <head>
    <EditorHmrGuard />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Fortune Telling and Speculative Design — slides</title>
    <script>
      import '../../components/unique/fortune-telling/main.js';
    </script>
  </head>
  <body><Fragment set:html={slides} /></body>
</html>
<style is:global>
  html, body, .reveal { width: 100%; height: 100%; margin: 0; overflow: hidden; }
</style>
