---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Title2 from "../components/mdx/typography/Title2.astro";
import TitleWithCount from "../components/layouts/TitleWithCount.astro";
import GardenFiltersAndHits from "../components/search/GardenFiltersAndHits.astro";
import PageWrapper from "../components/layouts/PageWrapper.astro";
import { extractPreview } from "../utils/extractPreview";
import { createPublicEntryManifest } from "../utils/publication.mjs";

// Get all content collections
const essays = await getCollection("essays");
const notes = await getCollection("notes");
const patterns = await getCollection("patterns");
const talks = await getCollection("talks");
const podcasts = await getCollection("podcasts");
const nowPosts = await getCollection("now");
const smidgeons = await getCollection("smidgeons");
const manifest = createPublicEntryManifest({
	essays,
	notes,
	patterns,
	talks,
	podcasts,
	now: nowPosts,
	smidgeons,
});
const { canonicalByCollection } = manifest;

const canonicalEssays = canonicalByCollection.essays;
const canonicalNotes = canonicalByCollection.notes;
const canonicalPatterns = canonicalByCollection.patterns;
const canonicalTalks = canonicalByCollection.talks;
const canonicalPodcasts = canonicalByCollection.podcasts;
const canonicalNowPosts = canonicalByCollection.now;
const canonicalSmidgeons = canonicalByCollection.smidgeons;

// Pre-process Now posts to extract body content for preview
const processedNowPosts = await Promise.all(
	canonicalNowPosts.map(async (post) => {
		try {
			// Use the post.body property directly, which contains the raw markdown
			const preview = extractPreview(post.body || "");
			return { ...post, preview };
		} catch (error) {
			console.warn(`Failed to extract preview for Now post ${post.id}:`, error);
			return { ...post, preview: "" };
		}
	}),
);

// Pre-process Smidgeons to extract preview content
const processedSmidgeons = await Promise.all(
	canonicalSmidgeons.map(async (post) => {
		try {
			// For all smidgeons, extract preview from body content
			const preview = extractPreview(post.body || "");
			return { ...post, preview };
		} catch (error) {
			console.warn(`Failed to extract preview for Smidgeon ${post.id}:`, error);
			return { ...post, preview: "" };
		}
	}),
);

// Combine all content into one array
const allPosts = [
	...canonicalEssays,
	...canonicalNotes,
	...canonicalPatterns,
	...canonicalTalks,
	...canonicalPodcasts,
	...processedNowPosts,
	...processedSmidgeons,
];
---

<Layout title="The Garden of Maggie Appleton" pageMetadata="webpage">
	<PageWrapper>
		<header style="margin-bottom: var(--space-xl);">
			<TitleWithCount posts={allPosts}>The Garden</TitleWithCount>
			<Title2>
				A collection of essays, notes, talks, podcasts, and half-baked explorations I'm always
				tending to.
			</Title2>
		</header>
		<GardenFiltersAndHits allPostData={allPosts} />
	</PageWrapper>
</Layout>
