---
import { Icon } from "astro-icon/components";
import type { MarkdownHeading } from "astro";

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const tocHeadings = headings.filter(({ depth }) => depth > 1 && depth < 4);
const tocIcon = "lucide:scroll-text";
---

<div class="desktop-container">
	<nav class="toc-panel" aria-labelledby="desktop-toc-title">
		<h4 class="title" id="desktop-toc-title">
			<Icon name={tocIcon} size={15} class="title-icon" aria-hidden="true" />
			Table of Contents
		</h4>
		<ul>
			{
				tocHeadings.map((heading, i) => (
					<li class="toc-item" data-level={heading.depth} style={`--i: ${i}`}>
						<a href={`#${heading.slug}`} class="toc-link">
							<span class="tick" aria-hidden="true" />
							<span class="label">{heading.text}</span>
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</div>

<div class="mobile-container">
	<h4>
		<button
			class="collapse-header"
			id="mobile-toc-header"
			type="button"
			aria-expanded="false"
			aria-controls="mobile-toc-content"
		>
			<Icon name={tocIcon} size={15} class="title-icon" aria-hidden="true" />
			<span class="collapse-header-text">Table of Contents</span>
		</button>
	</h4>
	<div class="collapse-content" id="mobile-toc-content">
		<nav class="toc">
			<ul>
				{
					tocHeadings.map((heading, i) => (
						<li class="toc-item" data-level={heading.depth} style={`--i: ${i}`}>
							<a href={`#${heading.slug}`} class="toc-link">
								{heading.text}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</div>

<style>
	.desktop-container {
		grid-column: 1;
		height: 0;
		max-width: 300px;
		margin-left: 6%;
		margin-right: var(--space-s);
		position: sticky;
		top: var(--space-m);
		z-index: 10;
	}

	/* At rest: a column of ticks, one per section, sized by section length.
	   On hover or keyboard focus, the ticks give way to the section names. */
	.toc-panel {
		--row-rest: var(--space-2xs);
		--row-open: var(--space-m);
		--label-width: 260px;
		--blur-dur: var(--dur-page);
		--pad-y: var(--space-3xs);
		--pad-x: var(--space-2xs);
		width: 180px;
		padding: var(--pad-y) var(--pad-x);
		margin: calc(-1 * var(--pad-y)) calc(-1 * var(--pad-x));
		border-radius: var(--border-radius-lg);
		transition:
			background-color var(--dur-quick) var(--ease-hover),
			backdrop-filter var(--dur-quick) var(--ease-hover);
	}

	.toc-panel:is(:hover, :focus-within) {
		width: calc(var(--label-width) + 2 * var(--pad-x));
	}

	/* Frosted only while a wide figure passes underneath, so the panel
	   doesn't show against the page gradient the rest of the time. */
	.desktop-container.over-wide .toc-panel {
		background: color-mix(in srgb, var(--color-white) 75%, transparent);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
	}

	.toc-panel .title {
		display: flex;
		gap: var(--space-2xs);
		align-items: center;
		margin: 0 0 var(--space-2xs);
		font-family: var(--font-sans);
		font-size: var(--font-size-xs);
		font-weight: 500;
		color: var(--color-gray-800);
		white-space: nowrap;
	}

	.title-icon {
		flex-shrink: 0;
		color: var(--color-gray-600);
	}

	.toc-panel ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.toc-panel li.toc-item {
		height: var(--row-rest);
		margin: 0 !important;
		transition: height var(--blur-dur) var(--ease-out);
	}

	.toc-panel:is(:hover, :focus-within) li.toc-item {
		height: var(--row-open);
	}

	.toc-panel .toc-link {
		position: relative;
		display: flex;
		align-items: center;
		height: 100%;
		text-decoration: none;
	}

	.tick {
		position: absolute;
		left: 0;
		top: 50%;
		width: var(--tick, 16px);
		height: 2px;
		margin-top: -1px;
		border-radius: 1px;
		background: var(--color-gray-300);
		transition:
			opacity var(--blur-dur) var(--ease-out),
			background-color var(--dur-quick) var(--ease-hover);
	}

	.toc-item[data-level="3"] .tick {
		left: var(--space-3xs);
	}

	.toc-link.active .tick {
		background: var(--color-sea-blue);
	}

	.toc-panel .label {
		width: var(--label-width);
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
		font-family: var(--font-sans);
		font-size: var(--font-size-xs);
		color: var(--color-gray-600);
		opacity: 0;
		filter: blur(10px);
		pointer-events: none;
		transition:
			opacity var(--blur-dur) var(--ease-out),
			filter var(--blur-dur) var(--ease-out),
			color var(--dur-quick) var(--ease-hover);
	}

	.toc-item[data-level="3"] .label {
		padding-left: var(--space-xs);
	}

	.toc-panel:is(:hover, :focus-within) .tick {
		opacity: 0;
	}

	/* Labels sharpen top-down in a quick cascade */
	.toc-panel:is(:hover, :focus-within) .label {
		opacity: 1;
		filter: blur(0);
		pointer-events: auto;
		transition-delay: calc(var(--i) * 35ms);
	}

	.toc-panel .toc-link:hover .label {
		color: var(--color-medium-sea-blue);
	}

	.toc-panel .toc-link.active .label {
		color: var(--color-sea-blue);
		font-weight: 500;
	}

	@media (prefers-reduced-motion: reduce) {
		.toc-panel li.toc-item,
		.toc-panel .label {
			transition-duration: 0ms;
			transition-delay: 0ms !important;
		}
		.toc-panel .label {
			filter: none;
		}
	}

	.mobile-container > h4 {
		margin: 0;
	}

	.mobile-container {
		display: none;
	}

	@media (max-width: 1310px) {
		.mobile-container {
			display: block;
			margin-bottom: var(--space-xs);
		}
		.desktop-container {
			display: none;
		}
	}

	.collapse-header {
		cursor: pointer;
		display: flex;
		align-items: center;
		gap: var(--space-2xs);
		border-bottom: 1px solid var(--color-gray-100);
		padding: var(--space-xs) 0;
		background: none;
		border-top: none;
		border-left: none;
		border-right: none;
		width: 100%;
		text-align: left;
		font: inherit;
		color: inherit;
	}

	.collapse-header-text {
		display: inline-block;
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--font-size-xs);
		color: var(--color-gray-800);
		font-weight: 600;
		transition: color var(--dur-quick) var(--ease-hover);
	}

	.collapse-header .title-icon {
		transition: color var(--dur-quick) var(--ease-hover);
	}

	.collapse-header:hover .collapse-header-text,
	.collapse-header:hover .title-icon {
		color: var(--color-medium-sea-blue);
	}

	/* Grid rows animate between 0fr and 1fr so the list opens to its
	   natural height; items blur in with the same cascade as desktop. */
	.collapse-content {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows var(--blur-dur) var(--ease-out);
	}

	.collapse-content.expanded {
		grid-template-rows: 1fr;
	}

	.mobile-container {
		--blur-dur: var(--dur-page);
	}

	.mobile-container .toc {
		min-height: 0;
		overflow: hidden;
		/* Keeps collapsed links out of the tab order, after the close finishes */
		visibility: hidden;
		transition: visibility 0s var(--blur-dur);
	}

	.collapse-content.expanded .toc {
		visibility: visible;
		transition-delay: 0s;
	}

	.mobile-container .toc ul {
		list-style: none;
		padding: var(--space-s) 0 var(--space-xs);
		margin: 0;
		border-bottom: 1px solid var(--color-gray-100);
	}

	.mobile-container li.toc-item {
		margin-left: 0 !important;
		margin-bottom: var(--space-2xs) !important;
		opacity: 0;
		filter: blur(10px);
		transition:
			opacity var(--blur-dur) var(--ease-out),
			filter var(--blur-dur) var(--ease-out);
	}

	.collapse-content.expanded li.toc-item {
		opacity: 1;
		filter: blur(0);
		transition-delay: calc(var(--i) * 35ms);
	}

	.toc-item::before {
		display: none !important;
	}

	.mobile-container .toc-link {
		font-family: var(--font-sans);
		display: block;
		line-height: var(--leading-base);
		font-size: var(--font-size-xs);
		cursor: pointer;
		transition: color var(--dur-quick) var(--ease-hover);
		color: var(--color-gray-600);
		text-decoration: none;
	}

	.mobile-container .toc-item[data-level="3"] .toc-link {
		margin-left: var(--space-xs);
	}

	.mobile-container .toc-link:hover {
		color: var(--color-medium-sea-blue);
	}

	.mobile-container .toc-link.active {
		color: var(--color-sea-blue);
		font-weight: 500;
	}

	@media (prefers-reduced-motion: reduce) {
		.collapse-content,
		.mobile-container li.toc-item {
			transition-duration: 0ms;
			transition-delay: 0ms !important;
		}
		.mobile-container li.toc-item {
			filter: none;
		}
	}
</style>

<script>
	(() => {

		const desktopContainer = document.querySelector(".desktop-container") as HTMLElement | null;
		const panelEl = desktopContainer?.querySelector(".toc-panel") as HTMLElement | null;
		const listEl = panelEl?.querySelector("ul") ?? null;
		const proseEl = desktopContainer?.parentElement ?? null;

		// Ensure desktop container has correct positioning after view transitions
		if (desktopContainer) {
			desktopContainer.style.gridColumn = "1";
			desktopContainer.style.position = "sticky";
			desktopContainer.style.zIndex = "10";
		}

		// Handle mobile TOC
		const header = document.querySelector(".collapse-header");
		const content = document.querySelector(".collapse-content");

		const desktopLinks = Array.from(
			document.querySelectorAll(".desktop-container .toc-link")
		) as HTMLAnchorElement[];

		const sections = desktopLinks
			.map((link) => {
				const id = link.getAttribute("href")?.slice(1);
				const heading = id ? document.getElementById(id) : null;
				return heading ? { link, heading } : null;
			})
			.filter((entry): entry is { link: HTMLAnchorElement; heading: HTMLElement } => entry !== null);

		// Tick width tracks how much page each section takes up
		const MIN_TICK = 6;
		const MAX_TICK = 32;
		const updateTickWidths = () => {
			if (!proseEl || sections.length === 0) return;
			const end = proseEl.getBoundingClientRect().bottom;
			const lengths = sections.map(({ heading }, i) => {
				const next = sections[i + 1]?.heading.getBoundingClientRect().top ?? end;
				return Math.max(0, next - heading.getBoundingClientRect().top);
			});
			const longest = Math.max(...lengths, 1);
			sections.forEach(({ link }, i) => {
				const width = MIN_TICK + (MAX_TICK - MIN_TICK) * (lengths[i] / longest);
				link.style.setProperty("--tick", `${Math.round(width)}px`);
			});
		};

		let activeIndex: number | null = null;
		// Top 30% counts as "current" so clicking a TOC link (which lands the
		// heading partway down) still activates it.
		const headingThreshold = () => window.innerHeight * 0.3;

		const setActiveClasses = () => {
			const activeId = activeIndex !== null ? sections[activeIndex].heading.id : null;
			document.querySelectorAll(".toc-link").forEach((link) => {
				const isActive = activeId !== null && link.getAttribute("href") === `#${activeId}`;
				link.classList.toggle("active", isActive);
				if (isActive) {
					link.setAttribute("aria-current", "true");
				} else {
					link.removeAttribute("aria-current");
				}
			});
		};

		const updateActiveHeading = () => {
			let newIndex: number | null = null;
			for (let i = 0; i < sections.length; i++) {
				const top = sections[i].heading.getBoundingClientRect().top;
				if (top - headingThreshold() <= 0) {
					newIndex = i;
				} else {
					break;
				}
			}

			if (newIndex === activeIndex) return;
			activeIndex = newIndex;
			setActiveClasses();
		};

		// Wide figures break out of the prose column and slide under the TOC.
		// While one does, frost the panel so it reads on top.
		const proseSiblings = Array.from(proseEl?.children ?? []).filter((el) => el !== desktopContainer);

		const overlapsProse = (box: { left: number; right: number; top: number; bottom: number }) =>
			proseSiblings.some((el) => {
				const r = el.getBoundingClientRect();
				return r.left < box.right && r.right > box.left && r.top < box.bottom && r.bottom > box.top;
			});

		// Spacing tokens are fluid calc()s, so resolve them by measuring
		const resolveLength = (value: string) => {
			if (!panelEl) return 0;
			const probe = document.createElement("div");
			probe.style.cssText = `position:absolute;visibility:hidden;width:${value}`;
			panelEl.appendChild(probe);
			const px = probe.getBoundingClientRect().width;
			probe.remove();
			return px;
		};

		const updateWideOverlap = () => {
			// Hidden below the desktop breakpoint
			if (!desktopContainer || !panelEl || panelEl.getClientRects().length === 0) return;

			const rect = panelEl.getBoundingClientRect();
			let box = rect.toJSON();
			// Judge the open state by its final footprint, not mid-transition
			if (panelEl.matches(":hover, :focus-within")) {
				const style = getComputedStyle(panelEl);
				const openRow = resolveLength("var(--row-open)");
				const labelWidth = resolveLength("var(--label-width)");
				const padX = parseFloat(style.paddingLeft) + parseFloat(style.paddingRight);
				box = {
					...box,
					right: rect.left + labelWidth + padX,
					bottom: (listEl?.getBoundingClientRect().top ?? rect.top) + sections.length * openRow + parseFloat(style.paddingBottom),
				};
			}
			// Before it sticks, the panel sits on the header gradient where
			// the frost reads as a stray box
			const stickyTop = parseFloat(getComputedStyle(desktopContainer).top);
			const isStuck = desktopContainer.getBoundingClientRect().top <= stickyTop + 1;
			desktopContainer.classList.toggle("over-wide", isStuck && overlapsProse(box));
		};

		let ticking = false;
		const scheduleUpdate = () => {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(() => {
				ticking = false;
				updateActiveHeading();
				updateWideOverlap();
			});
		};

		const layoutChangeHandler = () => {
			updateTickWidths();
			scheduleUpdate();
		};

		let proseResizeObserver: ResizeObserver | undefined;
		if (sections.length > 0) {
			updateTickWidths();
			updateActiveHeading();
			updateWideOverlap();

			window.addEventListener("scroll", scheduleUpdate, { passive: true });
			window.addEventListener("resize", layoutChangeHandler);

			// Images loading in reflow the page and change section lengths
			if (proseEl && "ResizeObserver" in window) {
				proseResizeObserver = new ResizeObserver(layoutChangeHandler);
				proseResizeObserver.observe(proseEl);
			}

			document.fonts?.ready?.then(layoutChangeHandler);
		}

		const panelEvents = ["pointerenter", "pointerleave", "focusin", "focusout"];
		panelEvents.forEach((type) => panelEl?.addEventListener(type, scheduleUpdate));

		// Mobile toggle handler
		const mobileClickHandler = () => {
			content?.classList.toggle("expanded");
			const isExpanded = content?.classList.contains("expanded") ?? false;
			(header as HTMLButtonElement)?.setAttribute("aria-expanded", String(isExpanded));
		};

		header?.addEventListener("click", mobileClickHandler);

		const onScrollSettled = (fn: () => void) => {
			if ("onscrollend" in window) {
				window.addEventListener("scrollend", fn, { once: true });
			} else {
				setTimeout(fn, 900);
			}
		};

		// Smooth scrolling for TOC links
		const linkHandlers: Array<{ link: Element; handler: EventListener }> = [];
		document.querySelectorAll(".toc-link").forEach((link) => {
			const linkClickHandler = (e: Event) => {
				e.preventDefault();
				e.stopPropagation();
				const targetId = (link as HTMLAnchorElement).getAttribute("href")?.slice(1);
				if (!targetId) return;

				const targetElement = document.getElementById(targetId);
				if (!targetElement) return;

				targetElement.scrollIntoView({
					behavior: "smooth",
					block: "start",
				});

				// Lazy images above the target can load mid-scroll and push it down,
				// so the smooth scroll stops short. Re-aim a few times once it settles.
				let corrections = 0;
				const correctScroll = () => {
					const top = targetElement.getBoundingClientRect().top;
					if (corrections++ < 3 && Math.abs(top) > window.innerHeight * 0.3) {
						targetElement.scrollIntoView({ behavior: "smooth", block: "start" });
						onScrollSettled(correctScroll);
					}
				};
				onScrollSettled(correctScroll);

				history.pushState(null, "", `#${targetId}`);
			};

			linkHandlers.push({ link, handler: linkClickHandler });
			link.addEventListener("click", linkClickHandler);
		});

		return () => {
			header?.removeEventListener("click", mobileClickHandler);
			window.removeEventListener("scroll", scheduleUpdate);
			window.removeEventListener("resize", layoutChangeHandler);
			proseResizeObserver?.disconnect();
			panelEvents.forEach((type) => panelEl?.removeEventListener(type, scheduleUpdate));
			linkHandlers.forEach(({ link, handler }) => {
				link.removeEventListener("click", handler);
			});
		};
	})();
</script>
