---
import { Icon } from "astro-icon/components";
import type { MarkdownHeading } from "astro";

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;
---

<div class="desktop-container">
	<h4>
		<button
			class="title"
			id="desktop-toc-header"
			type="button"
			aria-expanded="true"
			aria-controls="desktop-toc-content"
		>
			<svg width="8" height="8" aria-hidden="true">
				<circle r="4" cx="4" cy="4" fill="var(--color-sea-blue)"></circle>
			</svg>
			<span class="title-text">Table of Contents</span>
			<Icon name="heroicons:chevron-up" size={18} class="arrow-icon" aria-hidden="true" />
		</button>
	</h4>

	<nav class="toc" id="desktop-toc-content">
		<div class="toc-track">
			<span class="toc-marker" aria-hidden="true"></span>
			<ul>
				{
					headings
						.filter(({ depth }) => depth > 1 && depth < 4)
						.map((heading) => (
							<li class="toc-item" data-level={heading.depth}>
								<a href={`#${heading.slug}`} class="toc-link">
									{heading.text}
								</a>
							</li>
						))
				}
			</ul>
		</div>
	</nav>
</div>

<div class="mobile-container">
	<h4>
		<button
			class="collapse-header"
			id="mobile-toc-header"
			type="button"
			aria-expanded="false"
			aria-controls="mobile-toc-content"
		>
			<Icon name="heroicons:chevron-right" size={18} class="arrow-icon" aria-hidden="true" />
			<span class="collapse-header-text">Table of Contents</span>
		</button>
	</h4>
	<div class="collapse-content" id="mobile-toc-content">
		<nav class="toc">
			<ul>
				{
					headings
						.filter(({ depth }) => depth > 1 && depth < 4)
						.map((heading) => (
							<li class="toc-item" data-level={heading.depth}>
								<a href={`#${heading.slug}`} class="toc-link">
									{heading.text}
								</a>
							</li>
						))
				}
			</ul>
		</nav>
	</div>
</div>

<style>
	.arrow-icon {
		color: var(--color-gray-600);
		transition: all 0.3s cubic-bezier(0.2, 1, 0.8, 1);
	}

	.arrow-icon.collapsed {
		transform: rotate(180deg);
	}

	.desktop-container {
		grid-column: 1;
		height: 0;
		max-width: 300px;
		margin-left: 6%;
		margin-right: 24px;
		position: sticky;
		top: 16px;
		z-index: 10;
	}

	.desktop-container .title {
		display: flex;
		gap: 0.85rem;
		align-items: center;
		margin-top: 0.5rem;
		cursor: pointer;
		padding: var(--space-s);
		background: none;
		border: none;
		width: 100%;
		text-align: left;
		font: inherit;
		color: inherit;
	}

	.desktop-container > h4,
	.mobile-container > h4 {
		margin: 0;
	}

	.desktop-container .title-text {
		margin: 0;
		font-size: 0.96rem;
		color: var(--color-gray-800);
		transition: all 0.3s cubic-bezier(0.2, 1, 0.8, 1);
	}

	.desktop-container.collapsed .toc {
		max-height: 0;
		opacity: 0;
		pointer-events: none;
	}

	.toc {
		max-height: 80vh;
		opacity: 1;
		overflow: hidden;
		padding-right: var(--space-m);
		transition: all 0.3s cubic-bezier(0.2, 1, 0.8, 1);
	}

	.mobile-container {
		display: none;
	}

	@media (max-width: 1310px) {
		.mobile-container {
			display: block;
			margin-bottom: var(--space-xs);
		}
		.desktop-container {
			display: none;
		}
	}

	.collapse-header {
		cursor: pointer;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		border-bottom: 1px solid var(--color-gray-100);
		padding-bottom: var(--space-xs);
		background: none;
		border-top: none;
		border-left: none;
		border-right: none;
		width: 100%;
		text-align: left;
		font: inherit;
		color: inherit;
	}

	.collapse-header .arrow-icon {
		color: var(--color-sea-blue);
		transition: all 0.3s cubic-bezier(0.2, 1, 0.8, 1);
	}

	.collapse-header-text {
		display: inline-block;
		margin: 0;
		font-size: 0.96rem;
		color: var(--color-gray-800);
		font-weight: 600;
		transition: all 0.3s cubic-bezier(0.2, 1, 0.8, 1);
	}

	.collapse-header:hover .collapse-header-text {
		color: var(--color-medium-sea-blue);
	}

	.collapse-header:hover .arrow-icon {
		fill: var(--color-medium-sea-blue);
	}

	.collapse-content {
		padding-bottom: var(--space-xs);
		margin: var(--space-s) 0;
		border-bottom: 1px solid var(--color-gray-100);
		display: none;
	}

	.collapse-content.expanded {
		display: block;
	}

	.toc-track {
		position: relative;
	}

	.toc-marker {
		position: absolute;
		left: 2px;
		top: 0;
		width: 2px;
		height: 1px;
		border-radius: var(--border-radius-sm);
		background: var(--color-sea-blue);
		opacity: 0;
		transform-origin: top;
		transform: translateY(0) scaleY(0);
		transition:
			transform var(--dur-page) var(--ease-in-out),
			opacity var(--dur-quick) var(--ease-hover);
		pointer-events: none;
	}

	.toc ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	li.toc-item {
		margin-left: 22px !important;
		margin-bottom: 0.75rem !important;
	}

	.toc-item::before {
		display: none !important;
	}

	.toc-link {
		font-family: var(--font-sans);
		display: block;
		line-height: var(--leading-base);
		font-size: var(--font-size-sm);
		cursor: pointer;
		transition: color var(--dur-quick) var(--ease-hover);
		color: var(--color-gray-600);
		text-decoration: none;
	}

	.toc-item[data-level="1"] .toc-link,
	.toc-item[data-level="2"] .toc-link {
		margin-left: 0;
	}

	.toc-item[data-level="3"] .toc-link,
	.toc-item[data-level="4"] .toc-link {
		margin-left: 24px;
	}

	.toc-link:hover {
		color: var(--color-medium-sea-blue);
	}

	.toc-link.active {
		color: var(--color-sea-blue);
		font-weight: 500;
	}
</style>

<script>
	import { onPageLifecycle } from "../../utils/viewTransitionLifecycle";

	onPageLifecycle(() => {
		let scrollTimeoutId: ReturnType<typeof setTimeout> | undefined;
		let isCollapsed = false;
		let isAutoCollapsed = false;
		let isScrollingToSection = false;
		let disableAutoCollapse = false;

		const desktopContainer = document.querySelector(".desktop-container") as HTMLElement;
		const tocHeader = document.getElementById("desktop-toc-header");
		const arrowIcon = tocHeader?.querySelector(".arrow-icon");

		// Ensure desktop container has correct positioning after view transitions
		if (desktopContainer) {
			desktopContainer.style.gridColumn = "1";
			desktopContainer.style.position = "sticky";
			desktopContainer.style.top = "16px";
			desktopContainer.style.zIndex = "10";
		}

		// Handle mobile TOC
		const header = document.querySelector(".collapse-header");
		const content = document.querySelector(".collapse-content");
		const mobileArrow = header?.querySelector(".arrow-icon");

		// --- Active-section marker ------------------------------------------------
		// Tracks which heading is currently being read and slides a small bar
		// alongside the desktop TOC to follow it.
		const trackEl = document.querySelector(".desktop-container .toc-track") as HTMLElement | null;
		const markerEl = trackEl?.querySelector(".toc-marker") as HTMLElement | null;
		const desktopLinks = Array.from(
			document.querySelectorAll(".desktop-container .toc-link")
		) as HTMLAnchorElement[];

		// Pair each desktop link with the heading element it points to, in
		// document order, so we can tell which heading is "current" while scrolling.
		const sections = desktopLinks
			.map((link) => {
				const id = link.getAttribute("href")?.slice(1);
				const heading = id ? document.getElementById(id) : null;
				return heading ? { link, heading } : null;
			})
			.filter((entry): entry is { link: HTMLAnchorElement; heading: HTMLElement } => entry !== null);

		let activeIndex: number | null = null;
		const HEADING_THRESHOLD = 120; // px from top of viewport, roughly the sticky header offset

		const setActiveClasses = () => {
			const activeId = activeIndex !== null ? sections[activeIndex].heading.id : null;
			document.querySelectorAll(".toc-link").forEach((link) => {
				const isActive = activeId !== null && link.getAttribute("href") === `#${activeId}`;
				link.classList.toggle("active", isActive);
				if (isActive) {
					link.setAttribute("aria-current", "true");
				} else {
					link.removeAttribute("aria-current");
				}
			});
		};

		const positionMarker = (animate: boolean) => {
			if (!markerEl || !trackEl) return;

			if (!animate) markerEl.style.transition = "none";

			if (activeIndex === null) {
				markerEl.style.opacity = "0";
			} else {
				const trackRect = trackEl.getBoundingClientRect();
				const linkRect = sections[activeIndex].link.getBoundingClientRect();
				const top = linkRect.top - trackRect.top;
				const height = linkRect.height;
				markerEl.style.transform = `translateY(${top}px) scaleY(${height})`;
				markerEl.style.opacity = "1";
			}

			if (!animate) {
				// Force layout so the transition-less position is committed, then
				// re-enable transitions on the next frame for future moves.
				markerEl.getBoundingClientRect();
				requestAnimationFrame(() => {
					markerEl.style.transition = "";
				});
			}
		};

		const updateActiveHeading = (animate: boolean) => {
			let newIndex: number | null = null;
			for (let i = 0; i < sections.length; i++) {
				const top = sections[i].heading.getBoundingClientRect().top;
				if (top - HEADING_THRESHOLD <= 0) {
					newIndex = i;
				} else {
					break;
				}
			}

			if (newIndex === activeIndex) {
				if (!animate) positionMarker(false);
				return;
			}

			activeIndex = newIndex;
			setActiveClasses();
			positionMarker(animate);
		};

		let markerTicking = false;
		const scheduleMarkerUpdate = (animate: boolean) => {
			if (markerTicking) return;
			markerTicking = true;
			requestAnimationFrame(() => {
				markerTicking = false;
				updateActiveHeading(animate);
			});
		};

		const markerScrollHandler = () => scheduleMarkerUpdate(true);
		const markerResizeHandler = () => scheduleMarkerUpdate(false);

		let markerResizeObserver: ResizeObserver | undefined;
		if (sections.length > 0 && markerEl && trackEl) {
			// Set the initial position synchronously, with transitions disabled,
			// so the marker never slides in from a resting state on first paint.
			updateActiveHeading(false);

			window.addEventListener("scroll", markerScrollHandler, { passive: true });
			window.addEventListener("resize", markerResizeHandler);

			const list = trackEl.querySelector("ul");
			if (list && "ResizeObserver" in window) {
				markerResizeObserver = new ResizeObserver(() => scheduleMarkerUpdate(false));
				markerResizeObserver.observe(list);
			}

			document.fonts?.ready?.then(() => scheduleMarkerUpdate(false));
		}
		// ---------------------------------------------------------------------------

		// Desktop toggle handler
		const desktopClickHandler = () => {
			isCollapsed = !isCollapsed;
			isAutoCollapsed = false;
			disableAutoCollapse = false;
			desktopContainer?.classList.toggle("collapsed", isCollapsed);
			arrowIcon?.classList.toggle("collapsed", isCollapsed);
			(tocHeader as HTMLButtonElement)?.setAttribute("aria-expanded", String(!isCollapsed));
		};

		// Mobile toggle handler
		const mobileClickHandler = () => {
			content?.classList.toggle("expanded");
			mobileArrow?.classList.toggle("expanded");
			const isExpanded = content?.classList.contains("expanded") ?? false;
			(header as HTMLButtonElement)?.setAttribute("aria-expanded", String(isExpanded));
		};

		// Scroll handler for desktop auto-collapse
		const scrollHandler = () => {
			if (!desktopContainer || isScrollingToSection || disableAutoCollapse) return;

			const containerRect = desktopContainer.getBoundingClientRect();
			const isAtTop = containerRect.top <= 32;

			if (!isAtTop) {
				isCollapsed = false;
				isAutoCollapsed = false;
				desktopContainer.classList.remove("collapsed");
				arrowIcon?.classList.remove("collapsed");
				(tocHeader as HTMLButtonElement)?.setAttribute("aria-expanded", "true");
			} else if (!isAutoCollapsed && !isCollapsed) {
				isAutoCollapsed = true;
				isCollapsed = true;
				desktopContainer.classList.add("collapsed");
				arrowIcon?.classList.add("collapsed");
				(tocHeader as HTMLButtonElement)?.setAttribute("aria-expanded", "false");
			}
		};

		// Add event listeners
		tocHeader?.addEventListener("click", desktopClickHandler);
		header?.addEventListener("click", mobileClickHandler);
		window.addEventListener("scroll", scrollHandler);

		// Smooth scrolling for TOC links
		const linkHandlers: Array<{ link: Element; handler: EventListener }> = [];
		document.querySelectorAll(".toc-link").forEach((link) => {
			const linkClickHandler = (e: Event) => {
				e.preventDefault();
				e.stopPropagation();
				const targetId = (link as HTMLAnchorElement).getAttribute("href")?.slice(1);
				if (!targetId) return;

				const targetElement = document.getElementById(targetId);
				if (!targetElement) return;

				isScrollingToSection = true;
				disableAutoCollapse = true;

				targetElement.scrollIntoView({
					behavior: "smooth",
					block: "start",
				});

				clearTimeout(scrollTimeoutId);
				scrollTimeoutId = setTimeout(() => {
					isScrollingToSection = false;
				}, 1000);

				history.pushState(null, "", `#${targetId}`);
			};

			linkHandlers.push({ link, handler: linkClickHandler });
			link.addEventListener("click", linkClickHandler);
		});

		return () => {
			clearTimeout(scrollTimeoutId);
			tocHeader?.removeEventListener("click", desktopClickHandler);
			header?.removeEventListener("click", mobileClickHandler);
			window.removeEventListener("scroll", scrollHandler);
			window.removeEventListener("scroll", markerScrollHandler);
			window.removeEventListener("resize", markerResizeHandler);
			markerResizeObserver?.disconnect();
			linkHandlers.forEach(({ link, handler }) => {
				link.removeEventListener("click", handler);
			});
		};
	});
</script>
