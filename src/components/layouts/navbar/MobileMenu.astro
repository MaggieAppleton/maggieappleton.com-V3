---
import { Icon } from "astro-icon/components";
---

<div id="mobile-menu" class="mobile-menu" aria-hidden="true" inert>
	<nav class="mobile-nav">
		<a href="/garden" class="nav-link">The Garden</a>
		<a href="/essays" class="nav-link">Essays</a>
		<a href="/notes" class="nav-link">Notes</a>
		<a href="/patterns" class="nav-link">Patterns</a>
		<a href="/smidgeons" class="nav-link">Smidgeons</a>
		<a href="/talks" class="nav-link">Talks</a>
		<a href="/podcasts" class="nav-link">Podcasts</a>
		<a href="/library" class="nav-link">Library</a>
		<a href="/now" class="nav-link">Now</a>
		<a href="/about" class="nav-link">About</a>
	</nav>
</div>

<style>
	.mobile-menu {
		position: fixed;
		top: 0;
		right: 0;
		width: 100%;
		min-height: 100dvh;
		background: var(--color-cream);
		z-index: 1000;
		transform: translateX(100%);
		transition: transform 240ms cubic-bezier(0.215, 0.61, 0.355, 1);
		padding: var(--space-xl) var(--space-m);
	}

	.mobile-menu.open {
		transform: translateX(0);
	}

	.mobile-nav {
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
		margin-top: var(--space-l);
	}

	.nav-link {
		font-family: var(--font-body);
		font-size: var(--font-size-md);
		color: var(--color-gray-800);
		text-decoration: none;
		transition: color 0.2s ease-in-out;
	}

	.nav-link:hover {
		color: var(--color-crimson);
	}

	@media screen and (min-width: 551px) {
		.mobile-menu {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.mobile-menu {
			transition: none;
		}
	}
</style>

<script>
	(() => {
		const mobileMenu = document.getElementById("mobile-menu") as HTMLElement;
		const links = mobileMenu?.querySelectorAll("a");

		if (!mobileMenu || !links) return;

		// Instant close for non-click navigation (back button, etc.)
		const closeMobileMenu = () => {
			mobileMenu.classList.remove("open");
			mobileMenu.setAttribute("aria-hidden", "true");
			mobileMenu.inert = true;
			document.body.style.overflow = "auto";
		};

		const handleLinkClick = (e: Event) => {
			const link = e.currentTarget as HTMLAnchorElement;
			e.preventDefault();

			closeMobileMenu();

			if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
				// Tell the logo a real navigation is starting - it's about to
				// call location.href directly, bypassing the normal link click.
				document.dispatchEvent(new CustomEvent("mv:navigate-start"));
				window.location.href = link.href;
				return;
			}

			let hasNavigated = false;
			const navigateAfterClose = () => {
				if (hasNavigated) return;
				hasNavigated = true;
				document.dispatchEvent(new CustomEvent("mv:navigate-start"));
				window.location.href = link.href;
			};

			mobileMenu.addEventListener("transitionend", navigateAfterClose, { once: true });
			window.setTimeout(navigateAfterClose, 280);
		};

		links.forEach((link) => {
			link.addEventListener("click", handleLinkClick);
		});

		// Close before unload, and close instantly (no animation) if the page
		// is restored from bfcache with the menu still open.
		window.addEventListener("pagehide", closeMobileMenu);
		window.addEventListener("pageshow", (e) => {
			if (e.persisted) closeMobileMenu();
		});
	})();
</script>
