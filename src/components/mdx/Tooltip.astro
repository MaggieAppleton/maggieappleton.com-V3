---
interface Props {
	maxWidth?: string | number;
}

const { maxWidth = 400 } = Astro.props;
---

<span class="tooltip-trigger" data-maxwidth={maxWidth}>
	<template class="tooltip-content">
		<slot name="content" />
	</template>
	<slot />
</span>

<style is:global>
	.tippy-box[data-theme~="custom"] {
		font-family: var(--font-sans);
		font-size: var(--font-size-sm);
		line-height: var(--leading-snug);
		word-break: break-word;
		padding: var(--space-3xs);
		margin-bottom: var(--space-3xs);
		background-color: var(--color-white);
		color: var(--color-gray-800);
		box-shadow: var(--box-shadow-lg);
	}

	.tippy-box[data-theme~="custom"] * {
		font-family: var(--font-sans);
		font-size: var(--font-size-sm);
		line-height: var(--leading-snug);
		color: var(--color-gray-800);
	}

	.tippy-box[data-theme~="custom"] p {
		margin: 0;
	}

	.tippy-box[data-theme~="custom"] .tippy-arrow {
		color: var(--color-white);
	}

	/* Grow out of the link. Tippy waits for transitionend before unmounting,
	   so this must be a transition (not a keyframe animation). Tippy sets the
	   duration inline from its `duration` option. */
	.tippy-box[data-animation="grow"] {
		transition-property: transform, opacity;
		transition-timing-function: var(--ease-spring), var(--ease-out);
	}

	.tippy-box[data-animation="grow"][data-state="hidden"] {
		opacity: 0;
		transition-timing-function: var(--ease-out);
	}

	.tippy-box[data-animation="grow"][data-placement^="top"] {
		transform-origin: bottom center;
	}
	.tippy-box[data-animation="grow"][data-placement^="top"][data-state="hidden"] {
		transform: scale(0.94) translateY(4px);
	}

	.tippy-box[data-animation="grow"][data-placement^="bottom"] {
		transform-origin: top center;
	}
	.tippy-box[data-animation="grow"][data-placement^="bottom"][data-state="hidden"] {
		transform: scale(0.94) translateY(-4px);
	}

	.tippy-box[data-animation="grow"][data-placement^="left"] {
		transform-origin: right center;
	}
	.tippy-box[data-animation="grow"][data-placement^="left"][data-state="hidden"] {
		transform: scale(0.94) translateX(4px);
	}

	.tippy-box[data-animation="grow"][data-placement^="right"] {
		transform-origin: left center;
	}
	.tippy-box[data-animation="grow"][data-placement^="right"][data-state="hidden"] {
		transform: scale(0.94) translateX(-4px);
	}
</style>

<script>
	import tippy, { type Instance, type Props } from "tippy.js";
	import "tippy.js/dist/tippy.css";

	const tooltipInstances = new Set<Instance>();

	function initializeTooltips() {
		const tooltips = document.querySelectorAll(".tooltip-trigger");
		const reducedMotion = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		).matches;

		tooltipInstances.forEach((instance) => {
			if (!instance.reference.isConnected) {
				instance.destroy();
				tooltipInstances.delete(instance);
			}
		});

		tooltips.forEach((wrapper) => {
			const template = wrapper.querySelector(
				".tooltip-content",
			) as HTMLTemplateElement;
			const target =
				wrapper.querySelector(
					"a[href], button:not([disabled]), [tabindex]:not([tabindex='-1'])",
				) ?? wrapper;
			const existingInstance = (target as Element & { _tippy?: Instance })._tippy;
			if (existingInstance) {
				tooltipInstances.add(existingInstance);
				return;
			}
			const instance = tippy(
				target,
				{
					content: template.content.cloneNode(true),
					maxWidth: parseInt(wrapper.getAttribute("data-maxwidth") || "320"),
					duration: reducedMotion ? 0 : [240, 160],
					arrow: true,
					interactive: true,
					animation: reducedMotion ? false : "grow",
					allowHTML: true,
					appendTo: () => wrapper,
					theme: "custom",
					touch: target instanceof HTMLAnchorElement ? false : true,
					onCreate(instance) {
						setTimeout(() => {
							instance.setContent(instance.props.content);
						}, 0);
					},
				} as Partial<Props>,
			);
			tooltipInstances.add(instance);
		});
	}

	initializeTooltips();
	document.addEventListener("astro:page-load", initializeTooltips);
</script>
