---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    src: string;
    alt?: string;
    width?: string | number;
    margin?: string;
    showalt?: boolean;
    sourceUrl?: string;
    sourceTitle?: string;
    framed?: boolean;
    highQuality?: boolean;
    lightbox?: boolean;
}

const {
    src,
    alt = "",
    width = 1100,
    margin,
    showalt = false,
    sourceUrl,
    sourceTitle,
    framed = false,
    highQuality = false,
    lightbox = false,
} = Astro.props;

const quality = highQuality ? 95 : undefined;

const widthWithUnit = typeof width === "number" ? `${width}px` : width;

// Use glob import to get all images
const images = import.meta.glob<{ default: ImageMetadata }>("/src/images/**/*");

// If src is a string and starts with "/images", try to find it in the glob safely
let imageSrc: string | ImageMetadata = src as string | ImageMetadata;
if (typeof src === "string" && src.startsWith("/images")) {
    const key = "/src" + src;
    const loader = images[key as keyof typeof images];
    if (typeof loader === "function") {
        const mod = await loader();
        imageSrc = mod.default;
    } else {
        // Fallback to the original string if not found or not a function
        imageSrc = src;
    }
}

// Define sizes attribute for responsive images
const sizes = "(max-width: 440px) 100vw, (max-width: 768px) 90vw, (max-width: 1024px) 85vw, 1100px";

// Modified GIF detection logic
const isGif = typeof src === "string" && src.toLowerCase().endsWith(".gif");

// Check if imageSrc is ImageMetadata (from glob) or a string (fallback/remote)
const isImageMetadata = typeof imageSrc !== "string" && "src" in imageSrc;
---

<figure
    class:list={["container", { framed }]}
    style={`margin: ${margin || ""}`}
    data-basic-image="true"
    data-lightbox-item={lightbox ? "true" : undefined}
>
    <div
        class:list={["image-wrapper", { "image-frame": framed }]}
        style={`max-width: ${widthWithUnit}`}
        data-image-wrapper="true"
    >
        {
            isGif || !isImageMetadata ? (
                <img
                    src={typeof imageSrc === "string" ? imageSrc : imageSrc.src}
                    alt={alt}
                    class="styled-image"
                    loading="eager"
                />
            ) : (
                <Picture
                    src={imageSrc as ImageMetadata}
                    alt={alt}
                    sizes={sizes}
                    formats={["avif", "webp", "jpg", "png"]}
                    width={typeof width === "number" ? width : parseInt(width)}
                    quality={quality}
                    class="styled-image"
                    loading="eager"
                    decoding="async"
                />
            )
        }
        <span class="lightbox-affordance" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 9L3 3m0 0v5m0-5h5M15 9l6-6m0 0h-5m5 0v5M9 15l-6 6m0 0h5m-5 0v-5M15 15l6 6m0 0v-5m0 5h-5" />
            </svg>
        </span>
    </div>
    {
        showalt &&
            (sourceUrl ? (
                <figcaption>
                    {alt} – Source: <a href={sourceUrl}>{sourceTitle}</a>
                </figcaption>
            ) : (
                <figcaption>{alt}</figcaption>
            ))
    }
</figure>

<style>
    .container {
        grid-column: 1 / 4 !important;
        text-align: center;
        margin: var(--space-s) auto var(--space-l);
        max-width: inherit;
    }

    .image-wrapper {
        display: flex;
        justify-content: center;
        position: relative;
        width: 100%;
        margin: 0 auto;
        height: auto;
    }

    .image-wrapper[data-lightbox-enabled="true"] {
        cursor: zoom-in;
        outline-offset: 4px;
        transition: transform 150ms ease;
    }

    .lightbox-affordance {
        position: absolute;
        z-index: 2;
        top: 0.75rem;
        right: 0.75rem;
        display: grid;
        width: 2.25rem;
        height: 2.25rem;
        place-items: center;
        border-radius: 999px;
        color: white;
        background: rgba(20, 20, 20, 0.9);
        box-shadow: 0 4px 16px rgba(20, 20, 20, 0.22);
        opacity: 0;
        transform: scale(0.9);
        pointer-events: none;
        transition:
            opacity 150ms ease,
            transform 150ms ease;
    }

    .lightbox-affordance svg {
        width: 1rem;
        height: 1rem;
    }

    .image-wrapper[data-lightbox-enabled="true"]:focus-visible {
        transform: translateY(-2px) scale(1.015);
    }

    .image-wrapper[data-lightbox-enabled="true"]:focus-visible .lightbox-affordance {
        opacity: 1;
        transform: scale(1);
    }

    .image-wrapper::before {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: var(--border-radius-sm);
        animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    @keyframes pulse {
        0%,
        100% {
            opacity: 0.1;
        }
        50% {
            opacity: 0.3;
        }
    }

    .styled-image {
        height: auto;
        width: 100%;
        max-width: 100%;
        margin: 0 auto !important;
        border-radius: var(--border-radius-sm);
        position: relative;
        z-index: 1;
        object-fit: contain;
        display: block;
    }

    .image-frame {
        border: 1px solid var(--color-tinted-cream);
        border-radius: var(--border-radius-base);
        box-shadow: var(--box-shadow-md);
        margin-bottom: var(--space-xs);
        contain: content;
    }

    figcaption {
        font-family: var(--font-sans);
        font-size: var(--font-size-sm);
        color: var(--color-gray-600);
        line-height: 1.5;
        width: 100%;
        max-width: 800px;
        margin: var(--space-s) auto 0;
    }

    @media (max-width: 768px) {
        .container {
            margin: var(--space-s) auto;
        }
    }

    @media (hover: hover) and (pointer: fine) {
        .image-wrapper[data-lightbox-enabled="true"]:hover {
            transform: translateY(-2px) scale(1.015);
        }

        .image-wrapper[data-lightbox-enabled="true"]:hover .lightbox-affordance {
            opacity: 1;
            transform: scale(1);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .image-wrapper[data-lightbox-enabled="true"],
        .lightbox-affordance {
            transition: none;
        }

        .image-wrapper[data-lightbox-enabled="true"]:hover,
        .image-wrapper[data-lightbox-enabled="true"]:focus-visible {
            transform: none;
        }
    }
</style>
