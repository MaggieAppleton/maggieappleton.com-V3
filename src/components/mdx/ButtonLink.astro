---
import { Icon } from "astro-icon/components";
import Tooltip from "./Tooltip.astro";

const { href } = Astro.props;
---

<Tooltip>
	<div class="link-container">
		<a href={href} class="styled-link">
			<slot />
		</a>
	</div>

	<a slot="content" class="external-url" href={href}>
		{href}
		<Icon
			name="heroicons:arrow-top-right-on-square-20-solid"
			size={18}
			class="icon"
		/>
	</a>
</Tooltip>

<style>
	.external-url {
		color: var(--color-gray-600);
		transition: color var(--dur-quick) var(--ease-hover);
		text-align: center;
	}

	.external-url:hover {
		color: var(--color-bright-crimson);
	}

	.icon {
		position: relative;
		top: 3px;
	}

	.link-container {
		margin: var(--space-s) auto;
		transition: transform var(--dur-base) var(--ease-spring);
	}

	.styled-link {
		background-color: var(--color-bright-crimson);
		padding: var(--space-xs) var(--space-s);
		border-radius: var(--border-radius-base);
		color: white;
		font-weight: 400;
		font-family: var(--font-sans);
		transition: background-color var(--dur-quick) var(--ease-hover);
	}

	@media (hover: hover) and (pointer: fine) {
		.link-container:hover {
			transform: scale3d(1.02, 1.02, 1.02);
		}

		.styled-link:hover {
			background-color: var(--color-medium-sea-blue);
		}
	}

	.link-container:active {
		transform: scale3d(0.98, 0.98, 0.98);
		transition-duration: var(--dur-micro);
	}
</style>
