---
import internalLinkPreviews from "../../internal-link-previews.json";
import {
	classifyLink,
	resolveInternalLinkPreview,
} from "../../utils/internalLinkPreview.js";
import InternalPreviewContent from "./InternalPreviewContent.astro";
import Tooltip from "./Tooltip.astro";
import TooltipLinkAnchor from "./TooltipLinkAnchor.astro";

interface Props {
	href: string;
	noStyling?: boolean;
	notes?: string;
}

const { href, noStyling, notes } = Astro.props;

const linkContext = {
	currentUrl: Astro.url,
	siteUrl: Astro.site,
};
const classification = classifyLink(href, linkContext);
const internalPreview = resolveInternalLinkPreview(href, {
	...linkContext,
	previews: internalLinkPreviews,
});
const isExternal = classification.kind === "external";
const linkColor = isExternal
	? "var(--color-bright-crimson)"
	: "var(--color-medium-sea-blue)";
const hoverColor = isExternal
	? "var(--color-dark-sea-blue)"
	: "var(--color-crimson)";
---

{
	internalPreview ? (
		<Tooltip>
			<TooltipLinkAnchor
				href={href}
				internal="true"
				{noStyling}
				{linkColor}
				{hoverColor}
			>
				<slot />
			</TooltipLinkAnchor>
			<InternalPreviewContent
				slot="content"
				title={internalPreview.title}
				description={internalPreview.description}
			/>
		</Tooltip>
	) : isExternal ? (
		<Tooltip>
			<TooltipLinkAnchor
				href={href}
				internal="false"
				{noStyling}
				{linkColor}
				{hoverColor}
			>
				<slot />
			</TooltipLinkAnchor>
			<div slot="content">
				{notes && (
					<>
						<div class="notes">{notes}</div>
						<div class="divider" />
					</>
				)}
				<a class="external-url" href={href}>
					<span>{href}</span>
					<span class="icon-wrapper" aria-hidden="true">
						<svg
							width="18"
							height="18"
							viewBox="0 0 24 24"
							fill="none"
							xmlns="http://www.w3.org/2000/svg"
						>
							<path
								d="M10 6H6C4.89543 6 4 6.89543 4 8V18C4 19.1046 4.89543 20 6 20H16C17.1046 20 18 19.1046 18 18V14M14 4H20M20 4V10M20 4L10 14"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							/>
						</svg>
					</span>
				</a>
			</div>
		</Tooltip>
	) : (
		<TooltipLinkAnchor
			href={href}
			{noStyling}
			{linkColor}
			{hoverColor}
		>
			<slot />
		</TooltipLinkAnchor>
	)
}

<style>
	.external-url {
		color: var(--color-gray-600);
		transition: color 0.2s ease-in-out;
		word-break: break-word;
		overflow-wrap: break-word;
		max-width: 420px;
		display: flex;
		align-items: top;
		gap: 6px;
	}

	.external-url svg {
		margin: 0 !important;
		position: relative;
		top: 2px;
		color: var(--color-gray-300);
		flex-shrink: 0;
	}

	.external-url:hover {
		color: var(--color-bright-crimson);
	}

	.divider {
		width: calc(100% + 36px);
		height: 1px;
		background: var(--color-gray-300);
		margin: var(--space-xs) 0;
		margin-left: -18px;
		margin-right: -18px;
	}

	.notes {
		line-height: var(--leading-base);
		font-family: var(--font-sans);
		color: var(--color-gray-800);
		margin: 0;
		word-break: break-word;
		overflow-wrap: break-word;
	}
</style>
