---
import "./Footnote.css";
const { idName, isClosed } = Astro.props;
---

<span class:list={["footnote-container", { closed: isClosed }]}>
	<label for={idName} class="margin-toggle footnote-number"></label>
	<input type="checkbox" id={idName} class="margin-toggle" />
	<span class="footnote">
		<slot />
	</span>
</span>
