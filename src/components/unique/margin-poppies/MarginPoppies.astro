---
// Decorative 3D poppies scattered down the page margins on desktop only. The
// layer is an absolute overlay sized to the whole article (via .styled-main being
// positioned — see global.css), so each bloom's `top:%` tracks a spot on the page
// and its horizontal calc anchors it just outside the text column, out in the
// gutter. Purely decorative, so aria-hidden and pointer-events:none.
//
// Positions/poses come from config.ts (shared with the client renderer). Below
// MARGIN_BREAKPOINT the gutters are too slim, so the whole layer hides.
import { MARGIN_POPPIES } from "./config";
---

<div class="margin-poppies" aria-hidden="true">
	{
		MARGIN_POPPIES.map((p) => (
			<canvas
				class:list={["margin-poppy", `margin-poppy--${p.side}`]}
				style={`top:${p.top}%; ${
					p.side === "left"
						? `left: calc(50% - var(--mp-col-half) - ${p.inset}px);`
						: `left: calc(50% + var(--mp-col-half) + ${p.inset}px);`
				} width:${p.size}px; height:${p.size}px;`}
			/>
		))
	}
</div>

<script>
	import { initMarginPoppies } from "./margin-poppies";
	import { onPageLifecycle } from "../../../utils/viewTransitionLifecycle";

	onPageLifecycle(() => {
		const layers = document.querySelectorAll<HTMLElement>(".margin-poppies");
		if (layers.length === 0) return;

		const cleanups: Array<() => void> = [];
		layers.forEach((el) => {
			const cleanup = initMarginPoppies(el);
			if (typeof cleanup === "function") cleanups.push(cleanup);
		});

		return () => cleanups.forEach((off) => off());
	});
</script>

<style>
	.margin-poppies {
		position: absolute;
		inset: 0;
		/* Purely decorative and non-interactive — never eat clicks or overlap text
		   (blooms live in the gutters; z-index 0 keeps them under the prose if the
		   layout ever shifts). */
		pointer-events: none;
		z-index: 0;
		/* Half the text column's width, so the calc() below lands each bloom right
		   at the column's edge. Mirrors ProseWrapper's min(72ch, 100%) column. ch
		   is font-relative, so pin the font-size to match the prose column. */
		--mp-col-half: 36ch;
		font-size: var(--font-size-base);
		/* Hidden by default; shown only on wide desktop (see below). Keep this
		   breakpoint in sync with MARGIN_BREAKPOINT in config.ts. */
		display: none;
	}

	@media (min-width: 1200px) {
		.margin-poppies {
			display: block;
		}
	}

	.margin-poppy {
		position: absolute;
		display: block;
	}

	/* At-rest placement before/while JS isn't driving the transform. Left blooms
	   are anchored by their right edge, right blooms by their left edge — the
	   client renderer folds the same base into its per-frame transform. */
	.margin-poppy--left {
		transform: translateX(-100%);
	}
	.margin-poppy--right {
		transform: translateX(0);
	}

	/* Scoped to while the rAF loop is actually driving this bloom (toggled from
	   margin-poppies.ts), not held permanently — otherwise every canvas would keep
	   a promoted layer alive even off-screen. */
	.margin-poppy.is-animating {
		will-change: transform;
	}
</style>
