---
// One book faces out at a time; the rest show spine. Each book is a real CSS
// 3D cuboid (cover + spine at 90°) that rotates between the two states.

import { getImage } from "astro:assets";
import goodbyeToAllThatCover from "../../images/posts/in-memoriam/goodbye-all-that.jpg";
import birdsongCover from "../../images/posts/in-memoriam/birdsong.jpg";
import allQuietCover from "../../images/posts/in-memoriam/allquiet.webp";

// Rendered as background-images, not <img>/<Image> — an <img>'s separate
// texture upload occasionally dropped a frame mid-rotation in testing,
// flashing the cover blank.
const [goodbyeToAllThatOptimized, birdsongOptimized, allQuietOptimized] =
	await Promise.all(
		[goodbyeToAllThatCover, birdsongCover, allQuietCover].map((src) =>
			getImage({ src, format: "webp", width: 640 }),
		),
	);

interface Book {
	title: string;
	author: string;
	/** Real cover artwork URL. */
	coverImageSrc: string;
}

interface Props {
	books?: Book[];
	/** Index of the book that shows its cover on load. Defaults to 0. */
	defaultOpen?: number;
}

const {
	books = [
		{
			title: "Goodbye to All That",
			author: "Robert Graves",
			coverImageSrc: goodbyeToAllThatOptimized.src,
		},
		{
			title: "Birdsong",
			author: "Sebastian Faulks",
			coverImageSrc: birdsongOptimized.src,
		},
		{
			title: "All Quiet on the Western Front",
			author: "Erich Maria Remarque",
			coverImageSrc: allQuietOptimized.src,
		},
	],
	defaultOpen = 0,
}: Props = Astro.props;
---

<div class="bookshelf" role="group" aria-label="Interactive shelf of First World War books">
	<div class="bookshelf__row">
		{
			books.map((book, i) => {
				const isOpen = i === defaultOpen;
				return (
					<button
						class="book"
						class:list={{ "is-open": isOpen }}
						type="button"
						data-index={i}
						aria-pressed={isOpen ? "true" : "false"}
						aria-label={`Show cover of ${book.title} by ${book.author}`}
						style={`--spine-image: url(${book.coverImageSrc});`}
					>
						<span class="book__3d">
							<span class="book__tilt">
								<span class="book__face book__cover">
									<span
										class="book__cover-image"
										style={`background-image: url(${book.coverImageSrc});`}
										aria-hidden="true"
									/>
								</span>
								<span class="book__face book__spine">
									<span class="book__spine-text">{book.title}</span>
								</span>
								<span class="book__face book__pages" aria-hidden="true" />
							</span>
						</span>
					</button>
				);
			})
		}
	</div>
</div>

<script>
	import { onPageLifecycle } from "../../utils/viewTransitionLifecycle";

	onPageLifecycle(() => {
		const shelves = document.querySelectorAll<HTMLElement>(".bookshelf");
		if (shelves.length === 0) return;

		const cleanups: Array<() => void> = [];

		shelves.forEach((shelf) => {
			const books = Array.from(
				shelf.querySelectorAll<HTMLButtonElement>(".book"),
			);
			if (books.length === 0) return;

			function open(index: number) {
				books.forEach((book, i) => {
					const isOpen = i === index;
					book.classList.toggle("is-open", isOpen);
					book.setAttribute("aria-pressed", isOpen ? "true" : "false");
				});
			}

			const handlers: Array<() => void> = [];
			books.forEach((book, i) => {
				const onClick = () => {
					if (book.classList.contains("is-open")) return; // already open, no-op
					open(i);
				};
				book.addEventListener("click", onClick);
				handlers.push(() => book.removeEventListener("click", onClick));
			});

			cleanups.push(() => handlers.forEach((off) => off()));
		});

		return () => cleanups.forEach((off) => off());
	});
</script>

<style>
	.bookshelf {
		grid-column: 1 / 4 !important; /* break out to the wider media track, like BasicImage */
		container-type: inline-size; /* cqi not vw — max-width is capped below viewport width */

		--book-height: clamp(220px, 46cqi, 480px);
		--cover-width: clamp(140px, 30cqi, 310px);
		--spine-width: calc(clamp(44px, 8cqi, 84px) - 20px);
		--spine-slice-width: 20px; /* cover-edge slice stretched across the spine background */
		--book-gap: calc(var(--space-s) + 48px);
		--turn-duration: 0.7s;
		--turn-ease: cubic-bezier(0.65, 0.05, 0.36, 1);
		/* Closed books rest at a partial turn (not 90°) so a sliver of cover always
		   shows, Stripe Press style. --peek-reserve gives that sliver room without
		   overlapping the next book. */
		--peek-rotate: 84deg;
		--peek-reserve: clamp(12px, 4cqi, 20px);
		--paper-texture: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='120' height='120'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");

		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0;
		width: min(1100px, 100%);
		margin: var(--space-l) auto;
		margin-bottom: calc(var(--space-l) + var(--space-m));
		perspective: 8000px;
	}

	.bookshelf__row {
		margin: 0;
		padding: 0;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		gap: var(--book-gap);
	}

	/* Width animates between spine/cover widths so flexbox reflows neighbours in
	   lockstep — the browser's own reflow, unlike a hand-rolled offset which
	   briefly desynced from this book's own resizing. */
	.book {
		--rotate: var(--peek-rotate); /* closed: mostly-spine, with a cover peek */
		--width: var(--spine-width);

		position: relative;
		width: var(--width);
		height: var(--book-height);
		margin-right: var(--peek-reserve); /* room for this book's own peek; zeroed on .is-open */
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
		/* Large perspective keeps the two faces' depth difference imperceptible —
		   a close perspective (was 1400px) made closed books ~12% taller than open ones. */
		perspective: 8000px;
		transition:
			width var(--turn-duration) var(--turn-ease),
			margin-right var(--turn-duration) var(--turn-ease);
	}

	.book.is-open {
		--rotate: 0deg; /* open: cover faces the viewer */
		--width: var(--cover-width);
		margin-right: 0;
		cursor: default;
	}

	.book:focus-visible {
		outline: 2px solid var(--color-bright-crimson);
		outline-offset: 6px;
		border-radius: var(--border-radius-sm);
	}

	/* `left` is pinned via the fixed --cover-width/--spine-width tokens, not a %
	   of .book's animating width — a % re-derived mid-transition on the layout
	   thread and desynced from the compositor-driven rotateY, flashing a
	   garbled frame at the backface-visibility crossover. */
	.book__3d {
		position: absolute;
		top: 0;
		left: calc(var(--spine-width) / 2);
		width: var(--cover-width);
		height: 100%;
		transform-style: preserve-3d;
		transform: translateX(-50%) rotateY(var(--rotate));
		transition:
			left var(--turn-duration) var(--turn-ease),
			transform var(--turn-duration) var(--turn-ease);
	}

	.book.is-open .book__3d {
		left: calc(var(--cover-width) / 2);
	}

	/* Separate wrapper with an unconditional transition, so leaving hover animates
	   as fast as entering — scoping it to :hover made release fall back to
	   .book__3d's slow turn-duration, so a quick re-hover looked like it did nothing. */
	.book__tilt {
		position: absolute;
		inset: 0;
		transform-style: preserve-3d;
		transition: transform 0.15s ease-out;
	}

	.book:not(.is-open):hover .book__tilt,
	.book:not(.is-open):focus-visible .book__tilt {
		transform: translateY(-6px) rotateY(-4deg);
	}

	.book__face {
		position: absolute;
		top: 50%;
		left: 50%;
		height: var(--book-height);
		backface-visibility: hidden;
		box-sizing: border-box;
	}

	/* Front cover: the wide face, pushed forward by half the spine depth. */
	.book__cover {
		width: var(--cover-width);
		transform: translate(-50%, -50%) translateZ(calc(var(--spine-width) / 2));
		background: var(--color-light-cream);
		border-radius: var(--border-radius-sm);
		box-shadow: var(--box-shadow-md);
	}

	/* Rounded via border-radius: inherit, not overflow: hidden — overflow other
	   than visible flattens the element out of the preserve-3d hierarchy and
	   breaks the turn animation. */
	.book__cover-image {
		position: absolute;
		inset: 0;
		background-size: cover;
		background-position: center;
		border-radius: inherit;
	}

	/* Spine: narrow left face, rotated -90° and pushed out to meet the cover
	   at a 90° dihedral angle. */
	.book__spine {
		width: var(--spine-width);
		transform: translate(-50%, -50%) rotateY(-90deg)
			translateZ(calc(var(--cover-width) / 2));
		display: flex;
		align-items: center;
		justify-content: center;
		padding: var(--space-s) 0;
		position: relative;
		/* Edge lighting (after Stripe Press): bright rim where the cover peeks
		   from, fading dark on the trailing side. Layered over a thin stretched
		   slice of the cover art (--spine-image) so the design wraps onto the
		   spine without catching legible title fragments; the scrim beneath
		   keeps the spine title readable. */
		background:
			linear-gradient(
				to right,
				rgba(0, 0, 0, 0.4) 0%,
				rgba(0, 0, 0, 0.12) 10%,
				transparent 25%,
				transparent 60%,
				rgba(255, 255, 255, 0.14) 92%,
				rgba(255, 255, 255, 0.24) 100%
			),
			linear-gradient(rgba(10, 8, 6, 0.4), rgba(10, 8, 6, 0.4)),
			var(--spine-image) left center /
				calc(var(--cover-width) * var(--spine-width) / var(--spine-slice-width))
				var(--book-height) no-repeat;
		border: 1px solid rgba(0, 0, 0, 0.35); /* fixed dark tone, consistent under the scrim above */
		border-radius: var(--border-radius-sm);
		box-shadow: var(--box-shadow-sm);
		transition: box-shadow 0.25s ease;
	}

	/* Opacity fade, not filter: brightness() — profiling traced WebKit jank to
	   that filter re-rasterizing this face's large background every frame;
	   opacity is compositor-only. */
	.book__spine::before {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: #fff;
		opacity: 0;
		transition: opacity 0.15s ease-out;
		pointer-events: none;
	}

	.book:not(.is-open):hover .book__spine::before,
	.book:not(.is-open):focus-visible .book__spine::before {
		opacity: 0.12;
	}

	/* Grain overlay so the paper-edge block reads as board, not flat colour. */
	.book__pages::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background-image: var(--paper-texture);
		background-size: 120px 120px;
		mix-blend-mode: overlay;
		opacity: 0.35;
		pointer-events: none;
	}

	/* "You can click this" cue: a brighter spine on hover, kept small since a
	   bigger tilt would need more permanent --peek-reserve than it's worth. */
	.book:not(.is-open):hover .book__spine,
	.book:not(.is-open):focus-visible .book__spine {
		box-shadow: var(--box-shadow-md);
	}

	.book__spine-text {
		font-family: var(--font-sans);
		font-size: clamp(0.78rem, 2.2vw, 0.95rem);
		/* Not 1 — rotated 90° via text-orientation:mixed, line-height becomes
		   horizontal thickness; at 1 it clipped descenders (Birdsong's g). */
		line-height: 1.2;
		color: #fcfbf7; /* fixed, not themed — always sits under the same dark scrim */
		writing-mode: vertical-rl;
		text-orientation: mixed;
		white-space: nowrap;
		max-height: 100%;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* The page block on the right (+X) face — a sliver of paper edges. */
	.book__pages {
		width: var(--spine-width);
		transform: translate(-50%, -50%) rotateY(90deg)
			translateZ(calc(var(--cover-width) / 2));
		background: repeating-linear-gradient(
			to right,
			var(--color-cream),
			var(--color-cream) 1px,
			var(--color-tinted-cream) 2px,
			var(--color-cream) 3px
		);
		border-radius: var(--border-radius-sm);
	}

	/* Tighter gap on phones — the desktop +48px leaves too much dead air between narrow spines. */
	@media (max-width: 768px) {
		.bookshelf {
			--book-gap: calc(var(--space-s) + 16px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.book,
		.book__3d {
			transition-duration: 0.001s;
		}
	}
</style>
