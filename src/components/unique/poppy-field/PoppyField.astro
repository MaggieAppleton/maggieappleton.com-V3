---
import { MONTHLY, BATTLES, SOURCES_PREFIX, SOURCES_SUFFIX, SOURCE_CITATIONS } from "./wwi-monthly-deaths";
import { EDGE_INSET } from "./constants";
import { DEFAULTS } from "./params";
import { totalHeight, yForMonthIndex } from "./layout";

// Initial geometry uses DEFAULTS so labels are placed correctly before the client
// script runs; the client repositions them live from data-mindex on any change.
const initH = totalHeight(DEFAULTS);
const yAt = (i: number) => yForMonthIndex(i, DEFAULTS);

// Battle-label hover colour reuses the disease/"deep" OKLCH straight from
// params.ts — the field's single colour source of truth — rather than a
// hand-duplicated CSS custom property that can drift out of sync with it.
const battleHoverColor = `oklch(${DEFAULTS.diseaseL} ${DEFAULTS.diseaseC} ${DEFAULTS.diseaseH})`;

// Legend poppies are painted client-side with the real baked 3D sprites (see
// renderLegend in poppy-field.ts), so they match the field's shape, colour and
// lighting exactly rather than approximating it with flat SVG.
const legend = [
	{ cause: "combat", label: "Killed in action" },
	{ cause: "disease", label: "Disease & non-combat deaths" },
];

const years = [1914, 1915, 1916, 1917, 1918].map((y) => {
	const idx = MONTHLY.findIndex((m) => m.year === y);
	return { y, idx, top: yAt(idx) };
});
const months = MONTHLY.map((_, idx) => ({ idx, top: yAt(idx) }));
const battleLabels = BATTLES.map((b) => {
	const mid = (b.startIndex + b.endIndex) / 2;
	return { ...b, mid, top: yAt(mid) };
});
---

<figure class="poppy-field" style={`--total-h:${initH}px; --edge:${EDGE_INSET}px; --battle-hover:${battleHoverColor};`}>
	<p class="poppy-field__sr">
		A field of roughly 9,500 poppies, one for every 1,000 military dead in the First
		World War, arranged as a timeline running from August 1914 at the top to the
		Armistice of November 1918 at the bottom. The field is narrow at the start, widens
		into its greatest swell across the summer of 1916 (Verdun and the Somme), swells
		again through 1918, and stops abruptly at the war's end. Brighter five-petal
		poppies mark deaths in action; darker four-petal poppies mark deaths from disease,
		influenza, and other causes — roughly a third of the total.
	</p>

	<span class="poppy-field__legend poppy-field__legend--top" aria-hidden="true">
		{legend.map((it) => (
			<span class="poppy-field__legend-item">
				<canvas class="poppy-field__legend-poppy" data-cause={it.cause} aria-hidden="true"></canvas>
				{it.label}
			</span>
		))}
	</span>

	<div class="poppy-field__stage" style={`height:${initH}px; max-width:${DEFAULTS.maxWidth}px`} aria-hidden="true">
		<div class="poppy-field__spine"></div>
		{months.map((m) => (
			<span class="poppy-field__month-tick" data-mindex={m.idx} style={`top:${m.top}px`}></span>
		))}
		{years.map((t) => (
			<span class="poppy-field__year-tick" data-mindex={t.idx} style={`top:${t.top}px`}></span>
		))}
		{years.map((t) => (
			<span class="poppy-field__year" data-mindex={t.idx} style={`top:${t.top}px`}>{t.y}</span>
		))}
		{battleLabels.map((b) => (
			<button class="poppy-field__battle" data-battle={b.id} data-mindex={b.mid} tabindex="-1" style={`top:${b.top}px`}>
				<b>{b.label}</b>
				<i>{b.note}</i>
			</button>
		))}
		<canvas class="poppy-field__canvas"></canvas>
		<div class="poppy-field__tip" data-show="0">
			<span class="poppy-field__tip-month"></span> · <span class="poppy-field__tip-count"></span>
		</div>
	</div>

	<figcaption>
		<span class="poppy-field__caption-text">
			{SOURCES_PREFIX}
			{SOURCE_CITATIONS.map((c, i) => (
				<>
					<a href={c.url} target="_blank" rel="noopener noreferrer">{c.name}</a>{i < SOURCE_CITATIONS.length - 1 ? ", " : ""}
				</>
			))}
			{SOURCES_SUFFIX}
		</span>
	</figcaption>
</figure>

<script>
	import { initPoppyField } from "./poppy-field";
	import { onPageLifecycle } from "../../../utils/viewTransitionLifecycle";

	onPageLifecycle(() => {
		const fields = document.querySelectorAll<HTMLElement>(".poppy-field");
		if (fields.length === 0) return;

		const cleanups: Array<() => void> = [];
		fields.forEach((el) => {
			const cleanup = initPoppyField(el);
			if (typeof cleanup === "function") cleanups.push(cleanup);
		});

		return () => cleanups.forEach((off) => off());
	});
</script>

<style>
	.poppy-field {
		grid-column: 1 / 4 !important;
		width: 100%;
		margin: 0 0 var(--space-xl);
		padding-inline: var(--edge);
		box-sizing: border-box;
	}

	.poppy-field__stage {
		position: relative;
		width: 100%;
		margin-inline: auto;
	}

	.poppy-field__canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
	}

	.poppy-field__spine {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 50%;
		width: 1.5px;
		transform: translateX(-50%);
		background: linear-gradient(
			to bottom,
			transparent,
			var(--color-gray-300) 4%,
			var(--color-gray-300) 96%,
			transparent
		);
		pointer-events: none;
	}

	.poppy-field__year-tick,
	.poppy-field__month-tick {
		position: absolute;
		left: 50%;
		transform: translate(-50%, -50%);
		pointer-events: none;
	}

	.poppy-field__year-tick {
		width: 15px;
		height: 2px;
		background: var(--color-gray-600);
		z-index: 1;
	}

	.poppy-field__month-tick {
		width: 5px;
		height: 1px;
		background: var(--color-gray-300);
	}

	.poppy-field__year {
		position: absolute;
		left: calc(50% - 12px);
		transform: translate(-100%, -50%);
		font-family: var(--font-sans);
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-gray-600);
		background: var(--color-white);
		border-radius: var(--border-radius-sm);
		padding: 2px 6px;
		pointer-events: none;
		z-index: 2;
	}

	.poppy-field__battle {
		position: absolute;
		left: calc(50% + 16px);
		transform: translateY(-50%);
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1px;
		max-width: 40%;
		text-align: left;
		appearance: none;
		background: var(--color-white);
		border-radius: var(--border-radius-sm);
		border: none;
		padding: 3px 6px;
		cursor: default;
		color: var(--color-gray-600);
		z-index: 3;
		transition: color 0.2s ease;
	}

	.poppy-field__battle:hover {
		color: var(--battle-hover);
		outline: none;
	}

	.poppy-field__battle b {
		font-family: var(--font-sans);
		font-size: var(--font-size-sm);
		font-weight: 600;
		line-height: 1.15;
		color: inherit;
	}

	.poppy-field__battle i {
		font-style: normal;
		font-family: var(--font-sans);
		font-size: var(--font-size-sm);
		font-weight: 500;
		color: var(--color-gray-600);
	}

	.poppy-field__tip {
		position: absolute;
		top: 0;
		left: 0;
		margin: 12px 0 0 14px;
		padding: 0 6px;
		background: var(--color-cream);
		color: var(--color-gray-600);
		font-family: var(--font-sans);
		font-size: var(--font-size-sm);
		font-weight: 600;
		white-space: nowrap;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.15s ease;
		z-index: 4;
	}

	.poppy-field__tip[data-show="1"] {
		opacity: 1;
	}

	.poppy-field__tip-count {
		font-weight: 500;
	}

	.poppy-field figcaption {
		max-width: 60ch;
		margin: var(--space-s) auto 0;
		text-align: center;
		font-family: var(--font-sans);
		font-size: var(--font-size-sm);
		line-height: var(--leading-base);
		color: var(--color-gray-600);
	}

	.poppy-field__legend {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 6px 20px;
		margin-bottom: var(--space-2xs);
	}

	.poppy-field__legend--top {
		margin-bottom: var(--space-s);
	}

	.poppy-field__legend-item {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-family: var(--font-sans);
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-gray-600);
	}

	.poppy-field__legend-poppy {
		flex: none;
		width: 30px;
		height: 30px;
	}

	.poppy-field__caption-text {
		display: block;
	}

	.poppy-field__caption-text a {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.poppy-field__caption-text a:hover {
		color: var(--color-gray-800, var(--color-black));
	}

	.poppy-field__sr {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
		font-family: var(--font-sans);
	}

	@media (max-width: 767px) {
		.poppy-field__battle b {
			font-size: var(--font-size-xs);
		}
	}

	/* Phone layout: break the figure out past the content column to ~106vw so the
	   field is a touch wider than the screen — the widest months (Verdun/the
	   Somme) then bleed off the edges instead of leaving dead margin. The 53vw =
	   half of 106vw full-bleed trick relies on .styled-main being centred in the
	   viewport; the JS side (poppy-field.ts) drops the edge margin, thins the
	   poppies and heightens the field to match. Breakpoint mirrors MOBILE_BREAKPOINT.
	   The overflow past the screen is clipped by .styled-main:has(.poppy-field) in
	   global.css so it never adds a horizontal scrollbar. */
	@media (max-width: 640px) {
		.poppy-field {
			width: 106vw;
			margin-left: calc(50% - 53vw);
			padding-inline: 0;
		}
	}
</style>
