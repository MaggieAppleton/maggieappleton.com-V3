---
import Footer from "../components/layouts/Footer.astro";
import Navbar from "../components/layouts/navbar/Navbar.astro";
import { SEO } from "astro-seo";
import { ClientRouter } from "astro:transitions";
import { Agentation } from "agentation";
import { buildCanonicalUrl } from "../utils/canonical.mjs";
import { isMeaningfulDescription, requirePageDescription } from "../utils/descriptions.mjs";
import { createPageMetadataNode } from "../utils/pageMetadata.mjs";
import { SITE_IDENTITY } from "../utils/siteIdentity.mjs";
import SiteIdentityJsonLd from "../components/seo/SiteIdentityJsonLd.astro";
import "../global.css";

export interface Props {
	title?: string;
	desc?: string;
	type?: string;
	coverImage?: string;
	canonicalPath?: string;
	pageMetadata?: false | "webpage" | {
		type: "article" | "webpage";
		name?: string;
		datePublished?: string;
		dateModified?: string;
	};
}

const { title, desc = "", type, coverImage, canonicalPath, pageMetadata = false } = Astro.props;

const canonicalURL = buildCanonicalUrl(canonicalPath ?? Astro.url.pathname);

// Generate OG image URL based on canonical path so all versions share the same image
const canonicalPathname = new URL(canonicalURL).pathname;
const contentId = canonicalPathname.replace(/^\/?|\/?$/g, "");

// Use localhost URL in development, production URL otherwise
const baseUrl = import.meta.env.DEV ? "http://localhost:4321" : Astro.site;

// Construct OG image URL - now just using the content ID directly
const ogImageURL = type ? new URL(`/og/${contentId}.png`, baseUrl) : new URL(`/og.png`, baseUrl);

// Only add search params for non-content pages (like the homepage)
if (!type) {
	if (title) ogImageURL.searchParams.set("title", title);
	if (desc) ogImageURL.searchParams.set("description", desc);
	if (coverImage) ogImageURL.searchParams.set("coverImage", coverImage);
}

const normalizedPageMetadata: Exclude<Props["pageMetadata"], false | undefined> | false =
	pageMetadata === "webpage" ? { type: "webpage" } : (pageMetadata ?? false);
const resolvedDescription = normalizedPageMetadata !== false
	? requirePageDescription(desc, canonicalURL, SITE_IDENTITY.websiteDescription)
	: (isMeaningfulDescription(desc, SITE_IDENTITY.websiteDescription)
		? desc.trim()
		: SITE_IDENTITY.websiteDescription);
const pageNode = normalizedPageMetadata !== false
	? createPageMetadataNode({
			...normalizedPageMetadata,
			canonicalUrl: canonicalURL,
			name: normalizedPageMetadata.name ?? title,
			description: resolvedDescription,
			image: normalizedPageMetadata.type === "article" ? coverImage : undefined,
		})
	: undefined;
const articleMetadata = normalizedPageMetadata !== false && normalizedPageMetadata.type === "article"
	? normalizedPageMetadata
	: undefined;
const isArticle = Boolean(articleMetadata);

---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="color-scheme" content="light dark" />
		<meta name="google-site-verification" content="DQjzoQ_jeforeKNzt5jAvs0u0_gxGJKYoaYfpGdXt2A" />
		<link rel="apple-touch-icon" sizes="180x180" href="/images/favicon/apple-touch-icon.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/images/favicon/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/images/favicon/favicon-16x16.png" />
		<link rel="manifest" href="/manifest.json" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Maggie Appleton's RSS Feed"
			href="/rss.xml"
		/>
		<link rel="webmention" href="https://webmention.io/maggieappleton.com/webmention" />

		<link rel="pingback" href="https://webmention.io/maggieappleton.com/xmlrpc" />
		<link rel="me" href="https://bsky.app/profile/maggieappleton.com" />
		<link rel="preconnect" href="https://media.maggieappleton.com" />
		<ClientRouter />
		<SEO
			title={title}
			description={resolvedDescription}
			canonical={canonicalURL}
			openGraph={{
				basic: {
					type: isArticle ? "article" : "website",
					url: canonicalURL,
					title: title || "Maggie Appleton",
					image: ogImageURL.toString(),
				},
				...(isArticle
					? {
						article: {
							publishedTime: articleMetadata?.datePublished,
							...(articleMetadata?.dateModified
								? { modifiedTime: articleMetadata.dateModified }
								: {}),
							authors: [SITE_IDENTITY.personUrl],
						},
					}
					: {}),
				optional: {
					locale: "en_GB",
					description: resolvedDescription,
				},
				image: {
					alt: title || "Maggie Appleton's digital garden",
					width: 1200,
					height: 630,
				},
			}}
			twitter={{
				creator: "@mappletons",
				card: "summary_large_image",
				image: ogImageURL.toString(),
				imageAlt: title || "Maggie Appleton's digital garden",
			}}
		/>
		<SiteIdentityJsonLd pageNode={pageNode} />
	</head>
	<body>
		<Navbar />
		<main>
			<slot />
		</main>
		<Footer />
		{import.meta.env.DEV && <Agentation client:only="react" />}
		<style is:global>
			/* Improve Page speed */
			/* https://css-tricks.com/almanac/properties/c/content-visibility/ */
			img {
				content-visibility: auto;
			}
		</style>
	</body>
</html>
