# Existing local site settings
WEBMENTION_API_KEY=your-webmention-key

# Writing Assist (on the maggie/writing-assist branch)
TYPESAFE_API_KEY=your-typesafe-key
OPENAI_API_KEY=your-openai-key
OPENAI_REASONING_EFFORT=low

# Optional: the Anthropic adapter is available, but current tools use OpenAI.
# ANTHROPIC_API_KEY=your-anthropic-key

# Optional provider overrides
# OPENAI_MODEL=gpt-6-sol
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_API_KEY=your-local-model-key
